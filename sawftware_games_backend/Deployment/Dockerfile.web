FROM caddy:2.11.7-alpine AS maintenance
COPY sawftware_games_backend/Deployment/Caddyfile /etc/caddy/Caddyfile
COPY sawftware_games_backend/Deployment/maintenance/ /maintenance/

FROM node:22-bookworm-slim AS build
WORKDIR /src
ENV NG_BUILD_MAX_WORKERS=1
ENV NODE_OPTIONS=--max-old-space-size=640
COPY sawftware_games_frontend/package.json sawftware_games_frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY sawftware_games_frontend/ ./
RUN npm run build -- --configuration production,pi --output-path /out

FROM maintenance AS production
COPY --from=build /out/browser/ /srv/
